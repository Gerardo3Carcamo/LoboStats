# MySQL con el driver PyMySQL
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost/lobostats?charset=utf8mb4
JWT_SECRET_KEY=genere-un-secreto-aleatorio-largo
VERIFICATION_CODE_SECRET=genere-otro-secreto-aleatorio-largo

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=usuario-smtp
MAIL_PASSWORD=contrasena-smtp
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=no-reply@example.com

# Desarrollo local. En producción use true detrás de HTTPS.
JWT_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200
AUTH_DISABLED=false
