DATABASE_URL=mysql+pymysql://write_user:URL_ENCODED_PASSWORD@db-host:3321/lobostats_db?charset=utf8mb4
JWT_SECRET_KEY=generate-a-long-random-secret
VERIFICATION_CODE_SECRET=generate-another-long-random-secret

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sender@example.com
MAIL_PASSWORD=application-password-without-spaces
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=sender@example.com

FLASK_ENV=production
JWT_COOKIE_SECURE=true
CORS_ORIGINS=https://lobostats.example.com
AUTH_DISABLED=false
